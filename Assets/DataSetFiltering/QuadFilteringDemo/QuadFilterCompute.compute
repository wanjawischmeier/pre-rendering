#pragma kernel TransformVertices

#define TILE_SIZE 32
#define MAX_VERTS_PER_TILE  256
#define IS_DEPTH_VALID(sampled) (sampled.a > 0.001 && sampled.a != 1)
#define IS_DEPTH_INVALID(sampled) (sampled.a < 0.01 || sampled.a == 1)
#define IS_TARGET_OUT_OF_BOUNDS(tc) (tc.x < 0 || tc.x >= _OutputResolution.x || tc.y < 0 || tc.y >= _OutputResolution.y)
#define IS_UV_OUT_OF_BOUNDS(uv) any(uv < 0.0 || uv > 1.0)

uniform float _MapNearClip, _MapFarClip;
uniform uint2 _InputResolution, _DispatchResolution, _OutputResolution;
uniform float2 _UVOffset;
uniform float3 _Offset;
uniform float4x4 _CameraViewProj;
uniform float4x4 _OrientationMatricies[6];

Texture2D<float4> _InputColorBuffer;
RWTexture2D<int> RW_SWDepthBuffer;
RWTexture2D<int2> RW_VertexLookup;
AppendStructuredBuffer<float3x3> _HWVerts0, _HWVerts1, _HWVerts2, _HWVerts3;
RWStructuredBuffer<float2x3> g_SWQuads;
RWTexture2D<uint> g_SWTileCounters;

float3 GetTransformedVertexUV(float2 uv, float normalizedDepth)
{
    float depth = normalizedDepth * (_MapFarClip - _MapNearClip) + _MapNearClip; // Rescale depth
    
    float2 viewSpace = uv * 2 - 1; // To [-1, 1] NDC
    float3 dir = float3(viewSpace, 1); // Assume direction vector
    float3 pos = dir * depth; // Scale direction by depth

    float4 worldPosition = float4(pos, 1); // World space position
    float4 clipPos = mul(_CameraViewProj, worldPosition);
    if (clipPos.w <= 0)
        return float3(0, 0, -1); // Invalid position, return a sentinel value
    
    // Perspective divide
    float3 ndc = clipPos.xyz / clipPos.w;
    return ndc * 0.5 + 0.5; // Map NDC [-1, 1] to UV [0, 1]
}

float3 ComputeAABB(float3 v0, float3 v1, float3 v2, float3 v3)
{
    float2 d1 = v1.xy - v0.xy;
    float2 d2 = v2.xy - v0.xy;
    float2 d3 = v3.xy - v0.xy;

    float minX = min(0.0, min(d1.x, min(d2.x, d3.x)));
    float maxX = max(0.0, max(d1.x, max(d2.x, d3.x)));
    float minY = min(0.0, min(d1.y, min(d2.y, d3.y)));
    float maxY = max(0.0, max(d1.y, max(d2.y, d3.y)));

    float2 maxOffset = float2(maxX, maxY);
    float minOffset = max(-minX, -minY); // Shared min extent, to be able to pack quad in 3x2 matrix

    return float3(maxOffset, minOffset);
}

bool IsDegenerateTriangle(float3 v0, float3 v1, float3 v2)
{
    float3 edge1 = v1 - v0;
    float3 edge2 = v2 - v0;
    float3 crossProduct = cross(edge1, edge2);

    // Use the squared length of the cross product (area of parallelogram)
    float areaSquared = dot(crossProduct, crossProduct);

    // Epsilon depends on your scale, this is a safe default
    return areaSquared < 1e-14;
}

int ClassifyTriangle(float3 v0, float3 v1, float3 v2)
{
    // 0. Degenerate triangle check
    if (IsDegenerateTriangle(v0, v1, v2))
        return 0;

    // Convert vertex positions to pixel coordinates
    uint2 tc0 = floor(v0.xy * _OutputResolution);
    uint2 tc1 = floor(v1.xy * _OutputResolution);
    uint2 tc2 = floor(v2.xy * _OutputResolution);

    // 1. Regular tile classification
    uint2 tile0 = tc0 / TILE_SIZE;
    uint2 tile1 = tc1 / TILE_SIZE;
    uint2 tile2 = tc2 / TILE_SIZE;

    if (all(tile0 == tile1) && all(tile1 == tile2))
        return 1;

    // 2. Offset tile classification
    int halfTile = TILE_SIZE / 2;
    tile0 = (tc0 + halfTile) / TILE_SIZE;
    tile1 = (tc1 + halfTile) / TILE_SIZE;
    tile2 = (tc2 + halfTile) / TILE_SIZE;

    if (all(tile0 == tile1) && all(tile1 == tile2))
        return 2;

    // 3. Triangle spans multiple tiles
    return 3;
}


bool TryPushTriangleToHardwareRasterizer(float3 v0, float3 v1, float3 v2, uint3 threadID)
{
    if (IsDegenerateTriangle(v0, v1, v2))
        return true; // Discard degenerate triangles, but mark as pushed
    
    uint2 tc0 = floor(v0.xy * _OutputResolution);
    uint2 tc1 = floor(v1.xy * _OutputResolution);
    uint2 tc2 = floor(v2.xy * _OutputResolution);
    
    // Check if all three vertices lie in the same tile
    uint2 tile0 = tc0 / TILE_SIZE;
    uint2 tile1 = tc1 / TILE_SIZE;
    uint2 tile2 = tc2 / TILE_SIZE;
    
    if (!(all(tile0 == tile1) && all(tile1 == tile2)))
    // if (true)
    {   
        // Vertices are in different tiles, so we need to push to the hardware rasterizer
        float3x3 tri = float3x3(v0 * 2 - 1, v1 * 2 - 1, v2 * 2 - 1); // Convert to NDC
        // _HWVerts0.Append(tri);
        
        // Push to the appropriate buffer group
        uint bufferGroupIndex = (threadID.x ^ threadID.y ^ threadID.z) & 3;
        switch (bufferGroupIndex)
        {
            case 0:
                _HWVerts0.Append(tri);
                break;
            case 1:
                _HWVerts1.Append(tri);
                break;
            case 2:
                _HWVerts2.Append(tri);
                break;
            case 3:
                _HWVerts3.Append(tri);
                break;
        }
        
        return true;
    }
    
    // All vertices are in the same tile, so we can push to the software rasterizer
    return false;
}

bool IsOnePixelQuad(float3 v0, float3 v1, float3 v2, float3 v3)
{
    uint2 p0 = floor(v0.xy * _OutputResolution); // TODO: Remove redunant calculation and pass as argument
    uint2 p1 = floor(v1.xy * _OutputResolution);
    uint2 p2 = floor(v2.xy * _OutputResolution);
    uint2 p3 = floor(v3.xy * _OutputResolution);

    return all(p0 == p1) && all(p1 == p2) && all(p2 == p3);
}

void BinSoftwareQuadApproximation(float2x3 quadApprox, uint2 screenPos, bool useOffsetTileBuffer)
{
    uint2 tileCoord = screenPos / TILE_SIZE;
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;

    // Atomically increment the tile counter and get the vertex index
    uint localIndex;
    InterlockedAdd(g_SWTileCounters[tileCoord], 1, localIndex);

    if (localIndex < MAX_VERTS_PER_TILE)
    {
        uint globalIndex = tileIndex * MAX_VERTS_PER_TILE + localIndex;
        g_SWQuads[globalIndex] = quadApprox;
    }
    // Else: drop vertex (tile overflow)
}

void PushQuadToSoftwareRasterizer(float3 v0, float3 v1, float3 v2, float3 v3)
{
    uint2 targetIndex = floor(v0.xy * _OutputResolution);
    
    if (IsOnePixelQuad(v0, v1, v2, v3))
    {
        // One pixel quad, so we can just write to the depth buffer
        int depthInt = asint(v0.z); // InterlockedMin works only on int, so convert depth to int
        int oldDepthInt;
    
        InterlockedMin(RW_SWDepthBuffer[targetIndex], depthInt, oldDepthInt);
        return;
    }
    
    float3 aabb = ComputeAABB(v0, v1, v2, v3);
    float2x3 quadApprox = float2x3(v0, aabb);
    
    BinSoftwareQuadApproximation(quadApprox, targetIndex, 0);
}

[numthreads(8, 8, 1)]
void TransformVertices(uint3 id : SV_DispatchThreadID)
{
    // Check if bottom or right is out of bounds
    if (id.x >= _InputResolution.x - 1 || id.y >= _InputResolution.y - 1)
    {
        // Can't construct quad
        return;
    }
    
    // Compute texel coordinates
    uint3 tcOff = uint3(_InputResolution / _DispatchResolution, 0);
    float2 uv00 = float2(id.xy) / _DispatchResolution;
    uint2 tc00 = all(_InputResolution == _DispatchResolution) ? id.xy : uv00 * _InputResolution;
    
    uint2 tc10 = tc00 + tcOff.xz;
    float4 sampled10 = _InputColorBuffer[tc10];
    if (!IS_DEPTH_VALID(sampled10))
        return;
    
    uint2 tc01 = tc00 + tcOff.zy;
    float4 sampled01 = _InputColorBuffer[tc01];
    if (!IS_DEPTH_VALID(sampled01))
        return;
    
    float2 uv10 = float2(tc10) / _InputResolution;
    float2 uv01 = float2(tc01) / _InputResolution;
    
    float3 uv10_t = GetTransformedVertexUV(uv10, sampled10.a);
    float3 uv01_t = GetTransformedVertexUV(uv01, sampled01.a);
    
    float4 sampled00 = _InputColorBuffer[tc00];
    
    // TODO: Determine if and when we need to calculate this
    uint2 tc11 = tc00 + tcOff.xy;
    float2 uv11 = float2(tc11) / _InputResolution;
    float4 sampled11 = _InputColorBuffer[tc11];
    float3 uv11_t = GetTransformedVertexUV(uv11, sampled11.a);
    
    if (!IS_DEPTH_INVALID(sampled00))
    {
        float3 uv00_t = GetTransformedVertexUV(uv00, sampled00.a);
        if (!IS_UV_OUT_OF_BOUNDS(uv00_t) || !IS_UV_OUT_OF_BOUNDS(uv10_t) || !IS_UV_OUT_OF_BOUNDS(uv01_t))
        {
            int2 tc00_p = floor(uv00_t.xy * _OutputResolution);
            int tc00_pIndex = tc00_p.x + tc00_p.y * _OutputResolution.x;
            int depthInt = asint(uv00_t.z);
            RW_VertexLookup[id.xy] = int2(tc00_pIndex, depthInt);
            
            bool pushed = TryPushTriangleToHardwareRasterizer(uv01_t, uv10_t, uv00_t, id);
            if (!pushed && !IS_UV_OUT_OF_BOUNDS(uv00_t)) // TODO: Combine bounds checks
            {
                PushQuadToSoftwareRasterizer(uv00_t, uv10_t, uv01_t, uv11_t);
            }
        }
    }
    
    if (!IS_DEPTH_INVALID(sampled11))
    {
        TryPushTriangleToHardwareRasterizer(uv11_t, uv10_t, uv01_t, id);
    }
}


#pragma kernel RasterizeTileBinnedQuads

uniform bool _IsBufferOffset;

bool IsInAABB(float2 uv, float3 v0, float3 aabb)
{
    // Reconstruct the min and max corners of the AABB from v0 and the float3
    float2 minOffset = -aabb.z;
    float2 maxOffset = aabb.xy;

    float2 local = uv - v0.xy;

    // Check bounds
    return all(local >= minOffset) && all(local <= maxOffset);
}

bool IsInTriangle(float2 uv, float3 v0, float3 v1, float3 v2)
{
    float2 v0v1 = v1.xy - v0.xy;
    float2 v0v2 = v2.xy - v0.xy;
    float2 v0uv = uv - v0.xy;

    float d00 = dot(v0v1, v0v1);
    float d01 = dot(v0v1, v0v2);
    float d11 = dot(v0v2, v0v2);
    float d20 = dot(v0uv, v0v1);
    float d21 = dot(v0uv, v0v2);

    float denom = d00 * d11 - d01 * d01;
    if (denom == 0)
        return false; // Degenerate triangle

    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;

    return u >= 0 && v >= 0 && w >= 0;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void RasterizeTileBinnedQuads(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    // Calculate coords
    uint2 globalPixel = groupID.xy * TILE_SIZE + groupThreadID.xy;
    uint2 tileCoord = globalPixel / TILE_SIZE;
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;
    
    uint numTris = g_SWTileCounters[tileCoord];
    if (numTris == 0)
    {
        // No triangles in this tile, so skip
        return;
    }
    
    // Iterate over the triangles in this tile
    uint tileOffset = tileIndex * MAX_VERTS_PER_TILE;
    for (uint i = 0; i < min(numTris, MAX_VERTS_PER_TILE); i++)
    {
        // Load the triangle from the buffer
        float2x3 tri = g_SWQuads[tileOffset + i];
        float3 v0 = tri[0];
        float3 aabb = tri[1];

        // Check if the pixel is within the AABB
        float2 uv = float2(globalPixel) / _OutputResolution;
        if (IsInAABB(uv, v0, aabb))
        {
            int depthInt = asint(v0.z);
            
            RW_SWDepthBuffer[globalPixel] = depthInt;
            return;
        }
    }
}
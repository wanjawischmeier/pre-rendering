[numthreads(8, 8, 1)]
void TransformVertices(uint3 id : SV_DispatchThreadID)
{
    // Check if bottom or right is out of bounds
    if (id.x >= _InputResolution.x - 1 || id.y >= _InputResolution.y - 1)
    {
        // Can't construct quad
        return;
    }
    
    // Compute texel coordinates
    float2 uv00 = float2(id.xy) / _InputResolution;
    float4 sampled00 = _InputColorBuffer[id.xy];
    
    int2 lookup = int2(-1, 0);
    if (!IS_DEPTH_INVALID(sampled00))
    {
        float3 uv00_t = GetTransformedVertexUV(uv00, sampled00.a);
        if (!IS_UV_OUT_OF_BOUNDS(uv00_t))
        {
            int2 tc00_t = floor(uv00_t.xy * _OutputResolution);
            lookup.x = tc00_t.x + tc00_t.y * _OutputResolution.x; // Projected texel index
            lookup.y = asint(uv00_t.z); // Depth value
        }
        /*
        if (!IS_UV_OUT_OF_BOUNDS(uv00_t) || !IS_UV_OUT_OF_BOUNDS(uv10_t) || !IS_UV_OUT_OF_BOUNDS(uv01_t))
        {
            int2 tc00_p = floor(uv00_t.xy * _OutputResolution);
            int tc00_pIndex = tc00_p.x + tc00_p.y * _OutputResolution.x;
            int depthInt = asint(uv00_t.z);
            RW_VertexBuffer[id.xy] = int2(tc00_pIndex, depthInt);
            
            bool pushed = TryPushTriangleToHardwareRasterizer(uv01_t, uv10_t, uv00_t, id);
            if (!pushed && !IS_UV_OUT_OF_BOUNDS(uv00_t)) // TODO: Combine bounds checks
            {
                PushQuadToSoftwareRasterizer(uv00_t, uv10_t, uv01_t, uv11_t);
            }
        }
        */
    }
    
    RW_VertexBuffer[id.xy] = lookup;
}


#pragma kernel BinQuads

#define IN_SAME_PIXEL(tc00, tc10, tc01, tc11) (all(tc00 == tc10) && all(tc00 == tc01) && all(tc00 == tc11))

AppendStructuredBuffer<uint> _QuadIndexBuffer_HW0, _QuadIndexBuffer_HW1, _QuadIndexBuffer_HW2, _QuadIndexBuffer_HW3;

RWTexture2D<int> RW_DepthBuffer_SW;
RWStructuredBuffer<uint2> _QuadIndexBuffer_SW;
RWTexture2D<uint> _TileCounters_SW;

// Quad types:
// 0: No valid vertices (invalid quad)
// 1: Top valid vertices (v00, v10, v01)
// 2: Bottom valid vertices (v11, v10, v01)
// 3: All valid vertices (v00, v10, v01, v11)
uint ComputeQuadType(int2 v00, int2 v10, int2 v01, int2 v11, uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    bool topValid = v00.x != -1 && v10.x != -1 && v01.x != -1;
    bool bottomValid = v11.x != -1 && v10.x != -1 && v01.x != -1;

    uint quadType = 0;
    if (topValid)
        quadType |= 1; // Set bit 0
    if (bottomValid)
        quadType |= 2; // Set bit 1

    return quadType; // Values: 0, 1, 2, or 3
}

bool IsQuadSoftwareRasterizable(uint quadType, uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    // Calculate tile coordinates for each vertex
    uint2 tile00 = tc00 / TILE_SIZE;
    uint2 tile10 = tc10 / TILE_SIZE;
    uint2 tile01 = tc01 / TILE_SIZE;
    uint2 tile11 = tc11 / TILE_SIZE;
        
    // Check based on quad type
    switch(quadType)
    {
        case 1: // Top valid vertices (v00, v10, v01)
            return all(tile00 == tile10) && all(tile00 == tile01);
            
        case 2: // Bottom valid vertices (v11, v10, v01)
            return all(tile11 == tile10) && all(tile11 == tile01);
            
        case 3: // All valid vertices
            // All vertices must be in the same tile
            return all(tile00 == tile10) && all(tile00 == tile01) && all(tile00 == tile11);
            
        default: // No valid vertices (quadType == 0) or invalid value
            return false;
    }
}

uint2 GetTexCoordFromIndex(int index)
{
    uint x = index % _OutputResolution.x;
    uint y = index / _OutputResolution.x;
    return uint2(x, y);
}

void PushQuadToHardwareRasterizer(uint2 tc00, uint quadType)
{
    uint quadIndex = tc00.x + tc00.y * _InputResolution.x;
    uint packedIndex = (quadIndex << 2) | (quadType & 0x3);

    uint bufferGroupIndex = (tc00.x ^ tc00.y) & 3; // Bitwise equivalent to modulo 4
    switch (bufferGroupIndex)
    {
        case 0:
            _QuadIndexBuffer_HW0.Append(packedIndex);
            break;
        case 1:
            _QuadIndexBuffer_HW1.Append(packedIndex);
            break;
        case 2:
            _QuadIndexBuffer_HW2.Append(packedIndex);
            break;
        case 3:
            _QuadIndexBuffer_HW3.Append(packedIndex);
            break;
    }
}

uint PackAABBOffsets8_Tri(uint2 tc0, uint2 tc1, uint2 tc2)
{
    int2 d1 = int2(tc1) - int2(tc0);
    int2 d2 = int2(tc2) - int2(tc0);

    int minX = min(0, min(d1.x, d2.x));
    int minY = min(0, min(d1.y, d2.y));
    int maxX = max(0, max(d1.x, d2.x));
    int maxY = max(0, max(d1.y, d2.y));
    
    // Clamp to 0-255 for packing
    uint minX_u8 = (uint) (-minX) & 0xFF;
    uint minY_u8 = (uint) (-minY) & 0xFF;
    uint maxX_u8 = (uint) (maxX) & 0xFF;
    uint maxY_u8 = (uint) (maxY) & 0xFF;
    
    // Pack: [maxY | maxX | minY | minX] (each 8 bits)
    return (maxY_u8 << 24) | (maxX_u8 << 16) | (minY_u8 << 8) | minX_u8;
}

uint ComputeAABBOffsets8_Quad(uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    int2 d10 = int2(tc10) - int2(tc00);
    int2 d01 = int2(tc01) - int2(tc00);
    int2 d11 = int2(tc11) - int2(tc00);

    int minX = min(0, min(d10.x, min(d01.x, d11.x)));
    int minY = min(0, min(d10.y, min(d01.y, d11.y)));
    int maxX = max(0, max(d10.x, max(d01.x, d11.x)));
    int maxY = max(0, max(d10.y, max(d01.y, d11.y)));

    // Clamp to 0-255 for packing
    uint minX_u8 = (uint) (-minX) & 0xFF;
    uint minY_u8 = (uint) (-minY) & 0xFF;
    uint maxX_u8 = (uint) (maxX) & 0xFF;
    uint maxY_u8 = (uint) (maxY) & 0xFF;

    // Pack: [maxY | maxX | minY | minX] (each 8 bits)
    return (maxY_u8 << 24) | (maxX_u8 << 16) | (minY_u8 << 8) | minX_u8;
}

/*
int ClassifyTriangle(float3 v0, float3 v1, float3 v2)
{
    // 0. Degenerate triangle check
    if (IsDegenerateTriangle(v0, v1, v2))
        return 0;

    // Convert vertex positions to pixel coordinates
    uint2 tc0 = floor(v0.xy * _OutputResolution);
    uint2 tc1 = floor(v1.xy * _OutputResolution);
    uint2 tc2 = floor(v2.xy * _OutputResolution);

    // 1. Regular tile classification
    uint2 tile0 = tc0 / TILE_SIZE;
    uint2 tile1 = tc1 / TILE_SIZE;
    uint2 tile2 = tc2 / TILE_SIZE;

    if (all(tile0 == tile1) && all(tile1 == tile2))
        return 1;

    // 2. Offset tile classification
    int halfTile = TILE_SIZE / 2;
    tile0 = (tc0 + halfTile) / TILE_SIZE;
    tile1 = (tc1 + halfTile) / TILE_SIZE;
    tile2 = (tc2 + halfTile) / TILE_SIZE;

    if (all(tile0 == tile1) && all(tile1 == tile2))
        return 2;

    // 3. Triangle spans multiple tiles
    return 3;
}
*/

void PushQuadToSoftwareRasterizer(uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11, uint quadType)
{
    // Compute AABB offsets for the quad
    uint aabb;
    switch (quadType)
    {
        case 1: // Top valid vertices (v00, v10, v01)
            aabb = PackAABBOffsets8_Tri(tc00, tc10, tc01);
            break;
            
        case 2: // Bottom valid vertices (v01, v10, v11)
            aabb = PackAABBOffsets8_Tri(tc01, tc10, tc11);
            break;
            
        default: // All valid vertices, as quadType != 0 is expected
            aabb = ComputeAABBOffsets8_Quad(tc00, tc10, tc01, tc11);
            break;
    }
    
    uint2 tileCoord = tc00 / TILE_SIZE;
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;

    // Atomically increment tile counter and get the vertex index
    uint localIndex;
    InterlockedAdd(_TileCounters_SW[tileCoord], 1, localIndex);

    if (localIndex < MAX_VERTS_PER_TILE)
    {
        uint globalIndex = tileIndex * MAX_VERTS_PER_TILE + localIndex;
        uint texelIndex = tc00.x + tc00.y * _OutputResolution.x;
        
        _QuadIndexBuffer_SW[globalIndex] = uint2(texelIndex, aabb);
    }
    // Else: drop vertex (tile overflow)
}

[numthreads(8, 8, 1)]
void BinQuads(uint3 id : SV_DispatchThreadID)
{
    // Check if bottom or right is out of bounds
    if (id.x >= _InputResolution.x - 1 || id.y >= _InputResolution.y - 1)
    {
        // Can't construct quad
        return;
    }
    
    uint2 off = uint2(1, 0);
    int2 v00 = RW_VertexBuffer[id.xy];
    int2 v10 = RW_VertexBuffer[id.xy + off];
    int2 v01 = RW_VertexBuffer[id.xy + off.yx];
    int2 v11 = RW_VertexBuffer[id.xy + off.xx];
    
    uint2 tc00 = GetTexCoordFromIndex(v00.x);
    uint2 tc10 = GetTexCoordFromIndex(v10.x);
    uint2 tc01 = GetTexCoordFromIndex(v01.x);
    uint2 tc11 = GetTexCoordFromIndex(v11.x);
    
    if (IN_SAME_PIXEL(tc00, tc10, tc01, tc11))
    {
        // One pixel quad, so we can just write to the depth buffer
        int depthInt = v00.y;
        int oldDepthInt;
    
        InterlockedMin(RW_DepthBuffer_SW[tc00], depthInt, oldDepthInt);
        return;
    }
    
    uint quadType = ComputeQuadType(v00, v10, v01, v11, tc00, tc10, tc01, tc11);
    if (quadType == 0)
    {
        return;
    }
    
    bool isSoftwareRasterizable = IsQuadSoftwareRasterizable(quadType, tc00, tc10, tc01, tc11); // Choose render path
    if (isSoftwareRasterizable)
    {
        // Prefer software rasterization for quads that fit in a tile
        PushQuadToSoftwareRasterizer(tc00, tc10, tc01, tc11, quadType);
    }
    else
    {
        PushQuadToHardwareRasterizer(id.xy, quadType);
    }
}


#pragma kernel RasterizeTileBinnedQuads

uniform bool _IsBufferOffset;

bool PointInPackedAABB(uint2 tc00, uint2 p, uint packedAABB)
{
    // Unpack offsets
    uint minX = packedAABB & 0xFF;
    uint minY = (packedAABB >> 8) & 0xFF;
    uint maxX = (packedAABB >> 16) & 0xFF;
    uint maxY = (packedAABB >> 24) & 0xFF;
    /* Scary version, try later if this freaks out at screen borders
    uint2 minBounds = tc00 - uint2(minX, minY);
    uint2 maxBounds = tc00 + uint2(maxX, maxY);
    */
    int2 minBounds = int2(tc00) - int2(minX, minY);
    int2 maxBounds = int2(tc00) + int2(maxX, maxY);
    int2 pInt = int2(p);
    
    return all(pInt >= minBounds) && all(pInt <= maxBounds);
    // return all(p >= minBounds) && all(p <= maxBounds);
}

bool IsInTriangle(float2 uv, float3 v0, float3 v1, float3 v2)
{
    float2 v0v1 = v1.xy - v0.xy;
    float2 v0v2 = v2.xy - v0.xy;
    float2 v0uv = uv - v0.xy;

    float d00 = dot(v0v1, v0v1);
    float d01 = dot(v0v1, v0v2);
    float d11 = dot(v0v2, v0v2);
    float d20 = dot(v0uv, v0v1);
    float d21 = dot(v0uv, v0v2);

    float denom = d00 * d11 - d01 * d01;
    if (denom == 0)
        return false; // Degenerate triangle

    float v = (d11 * d20 - d01 * d21) / denom;
    float w = (d00 * d21 - d01 * d20) / denom;
    float u = 1.0 - v - w;

    return u >= 0 && v >= 0 && w >= 0;
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void RasterizeTileBinnedQuads(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    // Calculate coords
    uint2 globalPixel = groupID.xy * TILE_SIZE + groupThreadID.xy;
    uint2 tileCoord = globalPixel / TILE_SIZE;
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;
    
    uint numTris = _TileCounters_SW[tileCoord];
    if (numTris == 0)
    {
        // No triangles in this tile, so skip
        return;
    }
    
    // Iterate over the triangles in this tile
    uint tileOffset = tileIndex * MAX_VERTS_PER_TILE;
    for (uint i = 0; i < min(numTris, MAX_VERTS_PER_TILE); i++)
    {
        // Load the quad approx from the buffer
        uint2 quadApprox = _QuadIndexBuffer_SW[tileOffset + i];
        uint2 tc00 = GetTexCoordFromIndex(quadApprox.x);

        // Check if the pixel is within the AABB
        float2 uv = float2(globalPixel) / _OutputResolution;
        if (PointInPackedAABB(tc00, globalPixel, quadApprox.y))
        {
            // int depthInt = asint(v0.z);
            
            globalPixel.y = _OutputResolution.y - globalPixel.y - 1; // Flip Y for depth buffer
            RW_DepthBuffer_SW[globalPixel] = asint(0.5);
            return;
        }
    }
}
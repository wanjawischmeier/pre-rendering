#pragma kernel TranformVertices

#define IS_DEPTH_VALID(sampled) (sampled.a > 0.001 && sampled.a != 1)

uniform float _MapNearClip, _MapFarClip;
uniform uint2 _InputResolution, _DispatchResolution, _OutputResolution;
uniform float2 _UVOffset;
uniform float3 _Offset;
uniform float4x4 _OrientationMatricies[6];

Texture2D<float4> _InputColorBuffer;
RWTexture2D<int> RW_OutputDepthBuffer;
// RWTexture2D<int2> RW_VertexLookupBuffer;
AppendStructuredBuffer<float4> _HardwareVertices;

float3 GetTransformedVertexUV(float2 uv, float normalizedDepth)
{
    float depth = normalizedDepth * (_MapFarClip - _MapNearClip) + _MapNearClip; // rescale depth
    
    float2 viewSpace = uv * 2 - 1; // [-1, 1] NDC
    float3 dir = float3(viewSpace, 1); // Assume direction vector
    float3 pos = dir * depth; // Scale direction by depth

    float4 worldPosition = float4(pos, 1); // World space position
    worldPosition.xyz /= worldPosition.w;
    worldPosition.xyz += _Offset;
    
    depth = length(worldPosition);
    
    return float3(worldPosition.xy / worldPosition.z, depth);
}


[numthreads(8, 8, 1)]
void TranformVertices(uint3 id : SV_DispatchThreadID)
{
    if (id.x == 0 && id.y == 0)
    {
        _HardwareVertices.Append(float4(-0.5, -0.5, 0, 1));
        _HardwareVertices.Append(float4(0.5, -0.5, 0, 1));
        _HardwareVertices.Append(float4(0.0, 0.5, 0, 1));
    }
    
    // Check if bottom or right is out of bounds
    if (id.x + 1 >= _OutputResolution.x || id.y + 1 >= _OutputResolution.y)
    {
        // Can't construct quad
        return;
    }
    
    // Compute texel coordinates
    float2 uv = (float2) id.xy / _DispatchResolution;
    
    uint2 tc = all(_InputResolution == _DispatchResolution) ? id.xy : uv * _InputResolution;
    uint2 off = uint2(1, 0);
    
    float4 sampled10 = _InputColorBuffer[tc + off];
    if (!IS_DEPTH_VALID(sampled10))
        return;
    
    float4 sampled01 = _InputColorBuffer[tc + off.yx];
    if (!IS_DEPTH_VALID(sampled01))
        return;
    
    float4 sampled00 = _InputColorBuffer[tc];
    float4 sampled11 = _InputColorBuffer[tc];
    if (!IS_DEPTH_VALID(sampled00) && !IS_DEPTH_VALID(sampled11))
        return;
    
    float3 transformedVertex00 = GetTransformedVertexUV(uv, sampled00.a);
    float3 transformedVertex10 = GetTransformedVertexUV(uv, sampled10.a);
    float3 transformedVertex01 = GetTransformedVertexUV(uv, sampled01.a);
    float3 transformedVertex11 = GetTransformedVertexUV(uv, sampled11.a);

    /*
    float depth = sampled.a * (_MapFarClip - _MapNearClip) + _MapNearClip; // rescale depth
    
    float2 viewSpace = uv * 2 - 1; // [-1, 1] NDC
    float3 dir = float3(viewSpace, 1); // Assume direction vector
    float3 pos = dir * depth; // Scale direction by depth

    float4 worldPosition = float4(pos, 1); // World space position
    worldPosition.xyz /= worldPosition.w;
    worldPosition.xyz += _Offset;
    
    float2 transformedUV = worldPosition.xy / worldPosition.z;
    */
    
    
    transformedVertex00.xy += _UVOffset;
    
    int depthInt = asint(transformedVertex00.z); // InterlockedMin works only on int, so convert depth to int
    int oldDepthInt;
    
    uint2 targetIndex = floor(transformedVertex00.xy * _OutputResolution);
    if (targetIndex.x < 0 || targetIndex.x >= _OutputResolution.x || targetIndex.y < 0 || targetIndex.y >= _OutputResolution.y)
    {
        // Discard if out of bounds
        // RW_VertexLookupBuffer[floor(uv * _OutputResolution)] = int2(-1, 0); // TODO: replace with check for default value (0)
        return;
    }
    
    // RW_VertexLookupBuffer[floor(uv * _OutputResolution)] = (int2) targetIndex;
    InterlockedMin(RW_OutputDepthBuffer[targetIndex], depthInt, oldDepthInt);
}


#pragma kernel RenderQuads
#define TILE_SIZE 16
#define MAX_VALID_TEXELS 8
#define COPRIME_MULTIPLIER 109
#define VALIDITY_DETECTION_THRESHOLD 0.05

Texture2D<int> InputDepthBuffer;

// Shared memory for each thread group
groupshared float2 localUVs[MAX_VALID_TEXELS];
groupshared uint localCount;

// Apply a linear index shuffle
uint2 ScrambleID_Permuted(uint3 groupID, uint3 groupThreadID)
{
    // Flatten 2D local thread ID into 1D index
    uint flatIndex = groupThreadID.y * TILE_SIZE + groupThreadID.x;
    const uint tileArea = TILE_SIZE * TILE_SIZE;

    // Apply permutation
    uint permutedIndex = (flatIndex * COPRIME_MULTIPLIER) % tileArea;

    // Unflatten to 2D
    uint offsetX = permutedIndex % TILE_SIZE;
    uint offsetY = permutedIndex / TILE_SIZE;

    // Compute global ID
    uint2 tileOrigin = groupID.xy * TILE_SIZE;
    return tileOrigin + uint2(offsetX, offsetY);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void RenderQuads(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    /*

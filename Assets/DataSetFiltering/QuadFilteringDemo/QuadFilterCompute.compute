#pragma multi_compile _ _DEBUG_WIREFRAME
#pragma multi_compile _TILE_SIZE_4 _TILE_SIZE_8 _TILE_SIZE_16 _TILE_SIZE_32
#pragma multi_compile _MAX_VERTS_PER_TILE_64 _MAX_VERTS_PER_TILE_128 _MAX_VERTS_PER_TILE_256 _MAX_VERTS_PER_TILE_512

#pragma kernel TransformVertices

#if defined(_TILE_SIZE_4)
    #define TILE_SIZE 4
#elif defined(_TILE_SIZE_8)
    #define TILE_SIZE 8
#elif defined(_TILE_SIZE_16)
    #define TILE_SIZE 16
#elif defined(_TILE_SIZE_32)
    #define TILE_SIZE 32
#else
    #define TILE_SIZE 32 // Default to 32x32
#endif

#if defined(_MAX_VERTS_PER_TILE_64)
    #define MAX_VERTS_PER_TILE 64
#elif defined(_MAX_VERTS_PER_TILE_128)
    #define MAX_VERTS_PER_TILE 128
#elif defined(_MAX_VERTS_PER_TILE_256)
    #define MAX_VERTS_PER_TILE 256
#elif defined(_MAX_VERTS_PER_TILE_512)
    #define MAX_VERTS_PER_TILE 512
#else
    #define MAX_VERTS_PER_TILE 256 // Default to 256 vertices per tile
#endif

#define IS_DEPTH_VALID(sampled) (sampled.a > 0.001 && sampled.a != 1)
#define IS_DEPTH_INVALID(sampled) (sampled.a < 0.01 || sampled.a == 1)
#define IS_TARGET_OUT_OF_BOUNDS(tc) (tc.x < 0 || tc.x >= _OutputResolution.x || tc.y < 0 || tc.y >= _OutputResolution.y)
#define IS_UV_OUT_OF_BOUNDS(uv) any(uv < 0.0 || uv > 1.0)

uniform float _MapNearClip, _MapFarClip;
uniform uint2 _InputResolution, _DispatchResolution, _OutputResolution;
uniform float4x4 _CameraViewProj;

Texture2D<float4> _InputColorBuffer;
RWTexture2D<int2> RW_VertexBuffer;

float3 GetTransformedVertexUV(float2 uv, float normalizedDepth)
{
    float depth = normalizedDepth * (_MapFarClip - _MapNearClip) + _MapNearClip; // Rescale depth
    
    float2 viewSpace = uv * 2 - 1; // To [-1, 1] NDC
    float3 dir = float3(viewSpace, 1); // Assume direction vector
    float3 pos = dir * depth; // Scale direction by depth

    float4 worldPosition = float4(pos, 1); // World space position
    float4 clipPos = mul(_CameraViewProj, worldPosition);
    if (clipPos.w <= 0)
        return float3(0, 0, -1); // Invalid position, return a sentinel value
    
    // Perspective divide
    float3 ndc = clipPos.xyz / clipPos.w;
    return ndc * 0.5 + 0.5; // Map NDC [-1, 1] to UV [0, 1]
}

[numthreads(8, 8, 1)]
void TransformVertices(uint3 id : SV_DispatchThreadID) // TODO: Blit this instead
{
    // Check if bottom or right is out of bounds
    if (id.x >= _InputResolution.x - 1 || id.y >= _InputResolution.y - 1)
    {
        // Can't construct quad
        return;
    }
    
    // Compute texel coordinates
    float2 uv00 = float2(id.xy) / _InputResolution;
    float4 sampled00 = _InputColorBuffer[id.xy];
    
    int2 lookup = int2(-1, 0);
    if (!IS_DEPTH_INVALID(sampled00))
    {
        float3 uv00_t = GetTransformedVertexUV(uv00, sampled00.a);
        if (!IS_UV_OUT_OF_BOUNDS(uv00_t))
        {
            int2 tc00_t = floor(uv00_t.xy * _OutputResolution);
            lookup.x = tc00_t.x + tc00_t.y * _OutputResolution.x; // Projected texel index
            lookup.y = asint(uv00_t.z); // Depth value
        }
    }
    
    RW_VertexBuffer[id.xy] = lookup;
}


#pragma kernel BinQuads

#define MIN_BINNED_SIZE 5 // Minimum size of a binned quad to be processed in software rasterizer
#define IS_QUAD_VALID(v00, v10, v01, v11) (v00.x != -1 && v10.x != -1 && v01.x != -1 && v11.x != -1)

AppendStructuredBuffer<uint> _QuadIndexBuffer_HW0, _QuadIndexBuffer_HW1, _QuadIndexBuffer_HW2, _QuadIndexBuffer_HW3;

RWTexture2D<int> RW_DepthBuffer_SW;
RWTexture2D<float4> RW_DebugBuffer_SW;
RWStructuredBuffer<uint3> _QuadIndexBuffer_SW;
RWTexture2D<uint> _TileCounters_SW;

bool IsBackfacingQuad(uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    // Backface culling via signed area
    int2 a = tc00;
    int2 b = tc10;
    int2 c = tc01;

    // Compute signed area of triangle abc
    int cross = (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x);

    // Cull if the triangle is backfacing (i.e., negative area)
    return cross <= 0;
}

// Quad types:
// 0: No valid vertices (invalid quad)
// 1: Top valid vertices (v00, v10, v01)
// 2: Bottom valid vertices (v11, v10, v01)
// 3: All valid vertices (v00, v10, v01, v11)
uint ComputeQuadType(int2 v00, int2 v10, int2 v01, int2 v11, uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    bool topValid = v00.x != -1 && v10.x != -1 && v01.x != -1;
    bool bottomValid = v11.x != -1 && v10.x != -1 && v01.x != -1;

    uint quadType = 0;
    if (topValid)
        quadType |= 1; // Set bit 0
    if (bottomValid)
        quadType |= 2; // Set bit 1

    return quadType; // Values: 0, 1, 2, or 3
}

uint IsQuadSoftwareRasterizable(uint quadType, uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    const uint2 halfTile = TILE_SIZE >> 1;

    // Grid A (origin at 0,0)
    uint2 tile00_A = tc00 / TILE_SIZE;
    uint2 tile10_A = tc10 / TILE_SIZE;
    uint2 tile01_A = tc01 / TILE_SIZE;
    uint2 tile11_A = tc11 / TILE_SIZE;

    // Grid B (offset by TILE_SIZE / 2)
    uint2 tile00_B = (tc00 + halfTile) / TILE_SIZE;
    uint2 tile10_B = (tc10 + halfTile) / TILE_SIZE;
    uint2 tile01_B = (tc01 + halfTile) / TILE_SIZE;
    uint2 tile11_B = (tc11 + halfTile) / TILE_SIZE;

    bool fitsA = false;
    bool fitsB = false;

    if (quadType == 1)
    {
        fitsA = all(tile00_A == tile10_A) && all(tile00_A == tile01_A);
        fitsB = all(tile00_B == tile10_B) && all(tile00_B == tile01_B);
    }
    else if (quadType == 2)
    {
        fitsA = all(tile11_A == tile10_A) && all(tile11_A == tile01_A);
        fitsB = all(tile11_B == tile10_B) && all(tile11_B == tile01_B);
    }
    else if (quadType == 3)
    {
        fitsA = all(tile00_A == tile10_A) && all(tile00_A == tile01_A) && all(tile00_A == tile11_A);
        fitsB = all(tile00_B == tile10_B) && all(tile00_B == tile01_B) && all(tile00_B == tile11_B);
    }
    
    // Return tile mode: 0 = none, 1 = grid A, 2 = grid B, 3 = both
    return fitsA ? 1 : 0;
    return (fitsA ? 1 : 0) | (fitsB ? 2 : 0);
}

uint2 GetTexCoordFromIndex(int index, uint2 resolution)
{
    uint x = index % resolution.x;
    uint y = index / resolution.x;
    return uint2(x, y);
}

void PushQuadToHardwareRasterizer(uint2 tc00, uint quadType)
{
    uint quadIndex = tc00.x + tc00.y * _InputResolution.x;
    uint packedIndex = (quadIndex << 2) | (quadType & 0x3);

    uint bufferGroupIndex = (tc00.x ^ tc00.y) & 3; // Bitwise equivalent to modulo 4
    switch (bufferGroupIndex)
    {
        case 0:
            _QuadIndexBuffer_HW0.Append(packedIndex);
            break;
        case 1:
            _QuadIndexBuffer_HW1.Append(packedIndex);
            break;
        case 2:
            _QuadIndexBuffer_HW2.Append(packedIndex);
            break;
        case 3:
            _QuadIndexBuffer_HW3.Append(packedIndex);
            break;
    }
}

uint PackAABBOffsets8_Tri(uint2 tc0, uint2 tc1, uint2 tc2)
{
    int2 d1 = int2(tc1) - int2(tc0);
    int2 d2 = int2(tc2) - int2(tc0);

    int minX = min(0, min(d1.x, d2.x));
    int minY = min(0, min(d1.y, d2.y));
    int maxX = max(0, max(d1.x, d2.x));
    int maxY = max(0, max(d1.y, d2.y));
    
    // Clamp to 0-255 for packing
    uint minX_u8 = (uint) (-minX) & 0xFF;
    uint minY_u8 = (uint) (-minY) & 0xFF;
    uint maxX_u8 = (uint) (maxX) & 0xFF;
    uint maxY_u8 = (uint) (maxY) & 0xFF;
    
    // Pack: [maxY | maxX | minY | minX] (each 8 bits)
    return (maxY_u8 << 24) | (maxX_u8 << 16) | (minY_u8 << 8) | minX_u8;
}

uint ComputeAABBOffsets8_Quad(uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11)
{
    int2 d10 = int2(tc10) - int2(tc00);
    int2 d01 = int2(tc01) - int2(tc00);
    int2 d11 = int2(tc11) - int2(tc00);

    int minX = min(0, min(d10.x, min(d01.x, d11.x)));
    int minY = min(0, min(d10.y, min(d01.y, d11.y)));
    int maxX = max(0, max(d10.x, max(d01.x, d11.x)));
    int maxY = max(0, max(d10.y, max(d01.y, d11.y)));

    // Clamp to 0-255 for packing
    uint minX_u8 = (uint) (-minX) & 0xFF;
    uint minY_u8 = (uint) (-minY) & 0xFF;
    uint maxX_u8 = (uint) (maxX) & 0xFF;
    uint maxY_u8 = (uint) (maxY) & 0xFF;

    // Pack: [maxY | maxX | minY | minX] (each 8 bits)
    return (maxY_u8 << 24) | (maxX_u8 << 16) | (minY_u8 << 8) | minX_u8;
}

void PushQuadToSoftwareRasterizer(uint3 id, uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11, uint quadType, uint tileGridMode)
{
    // Compute AABB offsets for the quad
    uint aabb;
    switch (quadType)
    {
        case 1: // Top valid vertices (v00, v10, v01)
            aabb = PackAABBOffsets8_Tri(tc00, tc10, tc01);
            break;
            
        case 2: // Bottom valid vertices (v01, v10, v11)
            aabb = PackAABBOffsets8_Tri(tc01, tc10, tc11);
            break;
            
        default: // All valid vertices, as quadType != 0 is expected
            aabb = ComputeAABBOffsets8_Quad(tc00, tc10, tc01, tc11);
            break;
    }
    
    // Compute tile coordinate based on tile grid mode
    bool isGridOffset = tileGridMode == 2 || (tileGridMode == 3 && id.x % 2 == 0);
    uint2 tileCoord;
    if (isGridOffset) // Original grid
    {
        tileCoord = tc00 / TILE_SIZE;
    }
    else // Offset grid
    {
        tileCoord = (tc00 + (TILE_SIZE >> 1)) / TILE_SIZE;
        tileCoord.y += _OutputResolution.y / TILE_SIZE;
    }

    // Compute flat tile index
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;
    
    // Atomically increment counter and write if within limit
    uint localIndex;
    InterlockedAdd(_TileCounters_SW[tileCoord], 1, localIndex);

    if (localIndex < MAX_VERTS_PER_TILE)
    {
        uint globalIndex = tileIndex * MAX_VERTS_PER_TILE + localIndex;
        uint idIndex = id.x + id.y * _InputResolution.x;
        uint texelIndex = tc00.x + tc00.y * _OutputResolution.x;
        uint packedIdIndex = (idIndex << 2) | (quadType & 0x3);

        _QuadIndexBuffer_SW[globalIndex] = uint3(texelIndex, aabb, packedIdIndex);
    }
}

void RasterPixel(uint3 id, uint2 tc, int depthInt)
{
    tc.y = _OutputResolution.y - tc.y - 1; // Flip Y for depth buffer
        
    #ifdef _DEBUG_WIREFRAME
    float2 uv = float2(id.xy) / _InputResolution;
    RW_DebugBuffer_SW[tc] = float4(uv, 0, 1);
    #else
    depthInt |= 0x1; // Set the LSB to indicate a priority pixel
    int oldDepthInt;
    InterlockedMin(RW_DepthBuffer_SW[tc], depthInt, oldDepthInt);
    #endif
}

void RasterizeQuadIteratively(
    uint3 id,
    uint2 minCoord,
    uint2 maxCoord,
    uint2 tc00, uint2 tc10, uint2 tc01, uint2 tc11,
    int d00, int d10, int d01, int d11)
{
    // Convert depths from int to float (as they are stored as int via asint)
    float fd00 = asfloat(d00);
    float fd10 = asfloat(d10);
    float fd01 = asfloat(d01);
    float fd11 = asfloat(d11);

    // Triangle 0: (tc00, tc10, tc01)
    float area0 = float((tc10.x - tc00.x) * (tc01.y - tc00.y) - (tc10.y - tc00.y) * (tc01.x - tc00.x));
    // Triangle 1: (tc01, tc10, tc11)
    float area1 = float((tc10.x - tc01.x) * (tc11.y - tc01.y) - (tc10.y - tc01.y) * (tc11.x - tc01.x));

    [unroll(MIN_BINNED_SIZE)]
    for (uint y = minCoord.y; y <= maxCoord.y; ++y)
    {
        [unroll(MIN_BINNED_SIZE)]
        for (uint x = minCoord.x; x <= maxCoord.x; ++x)
        {
            uint2 p = uint2(x, y);
            bool inside = false;
            float depthF = 0.0;

            // --- First triangle: (tc00, tc10, tc01) ---
            int w0 = (tc10.x - p.x) * (tc01.y - p.y) - (tc10.y - p.y) * (tc01.x - p.x);
            int w1 = (tc01.x - p.x) * (tc00.y - p.y) - (tc01.y - p.y) * (tc00.x - p.x);
            int w2 = (tc00.x - p.x) * (tc10.y - p.y) - (tc00.y - p.y) * (tc10.x - p.x);

            if ((w0 | w1 | w2) >= 0 && area0 != 0)
            {
                float invArea = 1.0 / area0;
                float b0 = float(w0) * invArea;
                float b1 = float(w1) * invArea;
                float b2 = float(w2) * invArea;

                depthF = b0 * fd00 + b1 * fd10 + b2 * fd01;
                inside = true;
            }
            else
            {
                // --- Second triangle: (tc01, tc10, tc11) ---
                w0 = (tc10.x - p.x) * (tc11.y - p.y) - (tc10.y - p.y) * (tc11.x - p.x);
                w1 = (tc11.x - p.x) * (tc01.y - p.y) - (tc11.y - p.y) * (tc01.x - p.x);
                w2 = (tc01.x - p.x) * (tc10.y - p.y) - (tc01.y - p.y) * (tc10.x - p.x);

                if ((w0 | w1 | w2) >= 0 && area1 != 0)
                {
                    float invArea = 1.0 / area1;
                    float b0 = float(w0) * invArea;
                    float b1 = float(w1) * invArea;
                    float b2 = float(w2) * invArea;

                    depthF = b0 * fd01 + b1 * fd10 + b2 * fd11;
                    inside = true;
                }
            }

            if (inside)
            {
                int depthPacked = asint(depthF);
                RasterPixel(id, p, depthPacked);
            }
        }
    }
}

[numthreads(8, 8, 1)]
void BinQuads(uint3 id : SV_DispatchThreadID)
{
    // Check if bottom or right is out of bounds
    if (id.x >= _InputResolution.x - 1 || id.y >= _InputResolution.y - 1)
    {
        // Can't construct quad
        return;
    }
    
    uint2 off = uint2(1, 0);
    int2 v00 = RW_VertexBuffer[id.xy];
    int2 v10 = RW_VertexBuffer[id.xy + off];
    int2 v01 = RW_VertexBuffer[id.xy + off.yx];
    int2 v11 = RW_VertexBuffer[id.xy + off.xx];
    if (!IS_QUAD_VALID(v00, v10, v01, v11))
    {
        // Can't construct quad
        return;
    }
    
    uint2 tc00 = GetTexCoordFromIndex(v00.x, _OutputResolution);
    uint2 tc10 = GetTexCoordFromIndex(v10.x, _OutputResolution);
    uint2 tc01 = GetTexCoordFromIndex(v01.x, _OutputResolution);
    uint2 tc11 = GetTexCoordFromIndex(v11.x, _OutputResolution);
    if (IsBackfacingQuad(tc00, tc10, tc01, tc11))
    {
        // Cull backfacing quads
        return;
    }
    
    // Compute bounding box of the quad
    uint2 minCoord = min(min(tc00, tc10), min(tc01, tc11));
    uint2 maxCoord = max(max(tc00, tc10), max(tc01, tc11));
    
    // Check if the quad spans more than `threshold` pixels in either dimension
    uint2 size = maxCoord - minCoord;
    if (size.x < MIN_BINNED_SIZE && size.y < MIN_BINNED_SIZE)
    {
        if (size.x == 0 || size.y == 0)
        {
            // Quad is too small, skip
            return;
        }
        else if (size.x == 1 && size.y == 1)
        {
            // One pixel quad, so we can just write to the depth buffer
            RasterPixel(id, tc00, v00.y);
        }
        else
        {
            // Quad is small enough to be rasterized iteratively
            RasterizeQuadIteratively(id, minCoord, maxCoord, tc00, tc10, tc01, tc11, v00.y, v10.y, v01.y, v11.y);
        }
        return;
    }
    
    uint quadType = ComputeQuadType(v00, v10, v01, v11, tc00, tc10, tc01, tc11);
    if (quadType == 0)
    {
        return;
    }
    
    uint tileGridMode = IsQuadSoftwareRasterizable(quadType, tc00, tc10, tc01, tc11); // Choose render path
    if (tileGridMode == 0)
    {
        // Quad does not fit into software raster tile, push to hardware rasterizer
        // PushQuadToHardwareRasterizer(id.xy, quadType);
    }
    else
    {
        // Prefer software rasterization for quads that fit in a tile
        PushQuadToSoftwareRasterizer(id, tc00, tc10, tc01, tc11, quadType, tileGridMode);
    }
}


#pragma kernel RasterizeTileBinnedQuads
#define OVERDRAW_EPSILON -9 // This should not exist

uniform int _IsBufferOffset;

bool IsPointInPackedAABB(uint2 tc00, uint2 p, uint packedAABB)
{
    // Unpack offsets
    uint minX = packedAABB & 0xFF;
    uint minY = (packedAABB >> 8) & 0xFF;
    uint maxX = (packedAABB >> 16) & 0xFF;
    uint maxY = (packedAABB >> 24) & 0xFF;

    uint2 minBounds = tc00 - uint2(minX, minY);
    uint2 maxBounds = tc00 + uint2(maxX, maxY);
    
    return all(p >= minBounds) && all(p <= maxBounds);
}

int3 VertexCoord(uint2 tc)
{
    int2 packed = RW_VertexBuffer[tc];
    int index = packed.x;

    int3 coord;
    coord.x = index % _OutputResolution.x;
    coord.y = index / _OutputResolution.x;
    coord.z = packed.y; // depth value
    
    return coord; // screen-space coordinate (in pixels)
}

float Edge(float2 a, float2 b, float2 p)
{
    return (p.x - a.x) * (b.y - a.y) - (p.y - a.y) * (b.x - a.x);
}

int IsPixelInTriangle(float2 p, int3 a, int3 b, int3 c, bool useEdgeEpsilon, out float3 bary)
{
    float w0 = Edge(b.xy, c.xy, p);
    float w1 = Edge(c.xy, a.xy, p);
    float w2 = Edge(a.xy, b.xy, p);
    
    int area = (b.y - a.y) * (c.x - a.x) - (b.x - a.x) * (c.y - a.y); // No clue why this needs to be inverted
    if (area <= 0)
        return false; // Backfacing or degenerate

    float invArea = 1.0 / float(area);
    bary = float3(float(w0), float(w1), float(w2)) * invArea;
    
    // Epsilon handling:
    float eps0 = useEdgeEpsilon * OVERDRAW_EPSILON;
    float eps1 = 0.0; // No epsilon on second edge
    float eps2 = useEdgeEpsilon * OVERDRAW_EPSILON;
    
    // Please find forgiveness for this terrible hack (that doesn't even work, really)
    // but I've spend long enough on point in tri algorithms
    // return (w0 >= eps0 && w1 >= 0.0 && w2 >= eps2);
    bool isInTriangle = (w0 >= eps0 && w1 >= 0.0 && w2 >= eps2);
    return isInTriangle ? asint(asfloat(a.z) * bary.x + asfloat(b.z) * bary.y + asfloat(c.z) * bary.z) : -1; // Return depth value
}


int IsPixelInQuad(
    uint2 globalPixel,
    uint quadType,
    uint2 tc00_lookup,
    out float3 bary,
    out int3 v0, out int3 v1, out int3 v2)
{
    float2 p = float2(globalPixel);
    uint2 off = uint2(1, 0);

    // Shared quad vertices
    int3 v10 = VertexCoord(tc00_lookup + off);
    int3 v01 = VertexCoord(tc00_lookup + off.yx);
    
    // Early exit: Diagonal test (v01 to v10)
    int2 diag = v10.xy - v01.xy;
    int2 toP  = int2(p) - v01.xy;
    int cross = diag.x * toP.y - diag.y * toP.x;
    
    v0 = v1 = v2 = int3(0, 0, 0); // Make the compiler shut up
    bary = float3(0, 0, 0);

    if (cross < 0)
    {
        // Point is in top ccw triangle (v00, v01, v10)
        if (quadType == 2) // Top tri not valid
            return false;
        
        v0 = VertexCoord(tc00_lookup); // v00
        v1 = v01;
        v2 = v10;
    }
    else
    {
        // Point is in bottom ccw triangle (v01, v11, v10)
        if (quadType == 1) // Bottom tri not valid
            return false;
        
        v0 = v01;
        v1 = VertexCoord(tc00_lookup + off.xx); // v11
        v2 = v10;
    }
    
    return IsPixelInTriangle(p, v0, v1, v2, cross >= 0, bary);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void RasterizeTileBinnedQuads(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID, uint3 id : SV_DispatchThreadID)
{
    int oldDepthInt = RW_DepthBuffer_SW[id.xy];
    if (oldDepthInt & 0x1 != 0 && false)
    {
        // Pixel is already marked as a priority pixel, skip
        return;
    }
    
    // TODO: loat verts in tile atomically
    
    // Calculate coords
    uint2 tileCoord = (_IsBufferOffset == 0 ? id.xy : (id.xy + (TILE_SIZE >> 1))) / TILE_SIZE; // TODO: make this more straightforward
    if (_IsBufferOffset == 1)
    {
        tileCoord.y += _OutputResolution.y / TILE_SIZE;
        return;
    }
    // tileCoord = id.xy / TILE_SIZE;
    uint tileIndex = tileCoord.y * (_OutputResolution.x / TILE_SIZE) + tileCoord.x;
    
    uint numTris = _TileCounters_SW[tileCoord];
    if (numTris == 0)
    {
        // No triangles in this tile, so skip
        return;
    }
    
    // Iterate over the triangles in this tile
    uint tileOffset = tileIndex * MAX_VERTS_PER_TILE;
    for (uint i = 0; i < min(numTris, MAX_VERTS_PER_TILE); i++)
    {
        // Load the quad approx from the buffer
        uint3 quadApprox = _QuadIndexBuffer_SW[tileOffset + i];
        uint2 tc00 = GetTexCoordFromIndex(quadApprox.x, _OutputResolution);

        // Check if the pixel is within the AABB
        if (IsPointInPackedAABB(tc00, id.xy, quadApprox.y))
        {
            uint quadType = quadApprox.z & 0x3;
            uint idIndex = quadApprox.z >> 2;
            uint2 tc00_lookup = GetTexCoordFromIndex(idIndex, _InputResolution);
            
            int3 a, b, c;
            float3 bary;
            int depthInt = IsPixelInQuad(id.xy, quadType, tc00_lookup, bary, a, b, c);
            if (depthInt == -1 || (depthInt >= oldDepthInt && false))
            {
                // Pixel is not in the quad or further away than already rasterized pixel, skip
                continue;
            }
            
            id.y = _OutputResolution.y - id.y - 1; // Flip Y for depth buffer
            
            #ifdef _DEBUG_WIREFRAME
            RW_DebugBuffer_SW[id.xy] = float4(bary, 1);
            #else
            // TODO: Handle this in groupshared memory and a single dispatch instead of global atomics
            InterlockedMin(RW_DepthBuffer_SW[id.xy], depthInt, oldDepthInt);
            #endif
            
            // return; // cant return here :/ cause of random depth
        }
    }
}
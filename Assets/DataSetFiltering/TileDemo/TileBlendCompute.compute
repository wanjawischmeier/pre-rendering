// Tile-blending compute shader (unified dispatch)
// Based on distance-weighted blending with shared group sampling
#pragma kernel BlendTiles

#pragma multi_compile TILE_SIZE_4 TILE_SIZE_8 TILE_SIZE_16 TILE_SIZE_32
#pragma multi_compile TILE_CAPACITY_2 TILE_CAPACITY_4 TILE_CAPACITY_8 TILE_CAPACITY_16

#include "TileStructure.cginc"

#define TILE_RADIUS 2
#define SAMPLE_GRID (2 * TILE_RADIUS + 1)
#define TOTAL_SHARED_POINTS (MAX_VALID_TEXELS * SAMPLE_GRID * SAMPLE_GRID)

StructuredBuffer<Tile> _TileBuffer; // Packed tile data
RWTexture2D<float> _Output; // Output blended values

cbuffer Params
{
    float _TileSize; // 1.0 typically
    float _TileInfluenceRadius; // In tiles (e.g., 2.0)
    float _EdgeFalloffFactor; // Falloff scale for edge influence
    float _Epsilon; // Small constant
    float _DistWeight; // Weight falloff strength
    uint2 _GridSize; // Tile grid size
    uint2 _LowResWidth; // In tiles
    uint2 _HighResWidth; // Output resolution (in pixels)
};

// Shared memory for each thread group
groupshared float2 localUVs[TOTAL_SHARED_POINTS];
groupshared uint localCount;

// === Utility: Convert group/thread ID to global pixel position ===
uint2 GetPixelCoords(uint3 groupID, uint3 threadID)
{
    return groupID.xy * TILE_SIZE + threadID.xy;
}

// === Utility: Convert UV to tile index ===
uint GetTileIndex(uint2 tileCoord)
{
    return tileCoord.y * _LowResWidth.x + tileCoord.x;
}

// === Load valid data points from 5x5 neighborhood into shared memory ===
void LoadSurroundingTilePoints(uint2 pixelCoord, uint3 threadID)
{
    uint flatThreadID = threadID.y * TILE_SIZE + threadID.x;
    if (flatThreadID >= TOTAL_SHARED_POINTS)
        return;

    uint pIndex = flatThreadID;
    uint tileOffset = pIndex / MAX_VALID_TEXELS;
    uint innerIndex = pIndex % MAX_VALID_TEXELS;

    uint2 tileCoord = pixelCoord / TILE_SIZE;
    uint dx = tileOffset % SAMPLE_GRID - TILE_RADIUS;
    uint dy = tileOffset / SAMPLE_GRID - TILE_RADIUS;

    uint2 neighbor = tileCoord + uint2(dx, dy);
    if (neighbor.x < 0 || neighbor.y < 0 || neighbor.x >= _GridSize.x || neighbor.y >= _GridSize.y)
    {
        localUVs[pIndex] = float4(0, 0, 0, 0);
        return;
    }

    uint tileIndex = GetTileIndex(neighbor);
    Tile tile = _TileBuffer[tileIndex * MAX_VALID_TEXELS + innerIndex];
    localUVs[pIndex] = tile.uvs[];
}


// === Distance-weighted blend computation ===
float ComputeWeightedBlend(float2 pixelWorldPos)
{
    float totalWeight = 0.0;
    float weightedSum = 0.0;

    [unroll]
    for (int i = 0; i < TOTAL_SHARED_POINTS; i++)
    {
        float4 dp = sharedPoints[i];
        if (dp.a != 1)
            continue;

        float dist = distance(dp.xy, pixelWorldPos);

        float2 local = frac(dp.xy);
        float2 margin = min(local, 1.0 - local);
        float marginFactor = min(margin.x, margin.y);
        float maxInfluence = _TileInfluenceRadius - (1.0 - marginFactor) * _TileInfluenceRadius * _EdgeFalloffFactor;

        if (dist > maxInfluence)
            continue;

        float w = 1.0 / pow(dist + _Epsilon, _DistWeight);
        totalWeight += w;
        weightedSum += w * dp.z;
    }

    return (totalWeight > 0.0) ? (weightedSum / totalWeight) : 0.0;
}

// === Main kernel ===
[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void BlendTiles(uint3 groupID : SV_GroupID, uint3 threadID : SV_GroupThreadID, uint3 dispatchID : SV_DispatchThreadID)
{
    uint2 pixelCoord = GetPixelCoords(groupID, threadID);
    
    // Use first TOTAL_SHARED_POINTS threads to load data
    LoadSurroundingTilePoints(pixelCoord, threadID);
    GroupMemoryBarrierWithGroupSync();
    
    float2 pixelUV = (float2) pixelCoord / _HighResWidth;
    float2 pixelWorldPos = pixelUV * (_GridSize * _TileSize);
    float result = ComputeWeightedBlend(pixelWorldPos);
    
    _Output[pixelCoord] = result;
}

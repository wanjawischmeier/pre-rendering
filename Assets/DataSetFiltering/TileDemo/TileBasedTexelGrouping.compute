#pragma kernel GroupTexelsIntoTiles

#pragma multi_compile TILE_SIZE_4 TILE_SIZE_8 TILE_SIZE_16 TILE_SIZE_32
#if defined(TILE_SIZE_4)
    #define TILE_SIZE 4
    // Multiplier must be coprime with TILE_SIZE * TILE_SIZE (i.e., 256 if TILE_SIZE = 16)
    // or in other words, gcd(COPRIME_MULTIPLIER, sq(TILE_SIZE)) needs to be 1
    #define COPRIME_MULTIPLIER 3
#elif defined(TILE_SIZE_8)
    #define TILE_SIZE 8
    #define COPRIME_MULTIPLIER 11
#elif defined(TILE_SIZE_16)
    #define TILE_SIZE 16
    #define COPRIME_MULTIPLIER 109
#elif defined(TILE_SIZE_32)
    #define TILE_SIZE 32
    #define COPRIME_MULTIPLIER 311
#else
    #define TILE_SIZE 8 // Default value
    #define COPRIME_MULTIPLIER 9
#endif

#pragma multi_compile TILE_CAPACITY_4 TILE_CAPACITY_8 TILE_CAPACITY_16
#if defined(TILE_CAPACITY_4)
    #define MAX_VALID_TEXELS 4
#elif defined(TILE_CAPACITY_8)
    #define MAX_VALID_TEXELS 8
#elif defined(TILE_CAPACITY_16)
    #define MAX_VALID_TEXELS 16
#else
    #define MAX_VALID_TEXELS 4 // Default value
#endif

#define VALIDITY_DETECTION_THRESHOLD -0.01

struct TileResult
{
    float2 validUV[MAX_VALID_TEXELS];
    uint validCount;
};

int _HighResWidth, _LowResWidth;

RWStructuredBuffer<TileResult> _TileBuffer;
Texture2D<float> _HighResTexture;

// Shared memory for each 16x16 thread group
groupshared float2 localUVs[MAX_VALID_TEXELS];
groupshared uint localCount;

// Apply a linear index shuffle
uint2 ScrambleID_Permuted(uint3 groupID, uint3 groupThreadID)
{
    // Flatten 2D local thread ID into 1D index
    uint flatIndex = groupThreadID.y * TILE_SIZE + groupThreadID.x;
    const uint tileArea = TILE_SIZE * TILE_SIZE;

    // Apply permutation
    uint permutedIndex = (flatIndex * COPRIME_MULTIPLIER) % tileArea;

    // Unflatten to 2D
    uint offsetX = permutedIndex % TILE_SIZE;
    uint offsetY = permutedIndex / TILE_SIZE;

    // Compute global ID
    uint2 tileOrigin = groupID.xy * TILE_SIZE;
    return tileOrigin + uint2(offsetX, offsetY);
}

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void GroupTexelsIntoTiles(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID)
{
    uint2 scrambledID = ScrambleID_Permuted(groupID, groupThreadID);
    float2 uv = float2(scrambledID) / _HighResWidth;
    
    // First thread initializes the shared counter
    if (groupThreadID.x == 0 && groupThreadID.y == 0)
        localCount = 0;
    
    // Ensure counter is zero before anyone adds
    GroupMemoryBarrierWithGroupSync();

    float value = _HighResTexture.Load(int3(scrambledID, 0)).r;
    if (value > VALIDITY_DETECTION_THRESHOLD)
    {
        // Texel is valid, use atomic add on shared counter to get a slot index
        uint index = 0;
        InterlockedAdd(localCount, 1, index);
        
        if (index < MAX_VALID_TEXELS)
        {
            // Store the UV if we have space
            localUVs[index] = uv;
        }
    }
    
    // Wait until all threads are done writing to shared memory
    GroupMemoryBarrierWithGroupSync();

    // Let one thread per group write the result to global memory
    if (groupThreadID.x == 0 && groupThreadID.y == 0)
    {
        uint2 tileCoord = floor(uv * _LowResWidth);
        uint tileIndex = tileCoord.y * _LowResWidth + tileCoord.x;

        TileResult result;
        result.validCount = min(localCount, MAX_VALID_TEXELS);
        
        // Copy UVs from shared to global buffer
        [unroll]
        for (uint i = 0; i < MAX_VALID_TEXELS; i++)
        {
            result.validUV[i] = localUVs[i];
        }
        
        _TileBuffer[tileIndex] = result;
    }
}

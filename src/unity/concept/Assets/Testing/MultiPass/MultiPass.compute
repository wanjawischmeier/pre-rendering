#define NCLIP 1
#define FCLIP 30
#pragma multi_compile __ WIREFRAME

Texture2D<float4> Input;
RWTexture2D<float> Depth, DepthReprojected, DepthResult;
RWTexture2D<float2> Transformed;
RWTexture2D<float2> Upscaled;
RWTexture2D<float4> InvTransformed, Result;
SamplerState sampler_linear_repeat;

bool DEBUG;
int SEARCH_RADIUS;
float TIMESTEP;
float2 RESOLUTION, GROUP_SIZE;
float3 OFFSET;
float PI, PI2;




#pragma kernel Project

int2 project(float2 uv, float d0, out float d)
{
    float2 ll1 = uv.yx;
    ll1.x *= PI;
    ll1.y *= PI2;
    ll1.y += PI;

    float CP = d0 * (FCLIP - NCLIP) + NCLIP;

    float3 P = float3(
        CP * sin(ll1.y) * sin(ll1.x),
        CP * cos(ll1.x),
        CP * cos(ll1.y) * sin(ll1.x));
    
    P.y += sin(TIMESTEP / 50) * sin(length(P)) * sin(P.x);
    P -= OFFSET;
    // P = mul(TR, P);
    d = length(P);

    float2 ll2 = float2(
        acos(P.y / d),
        atan2(P.x, P.z));

    float2 a = float2(
        ll2.y / PI2,
        ll2.x / PI);
    a.x += 0.5;

    return (int2) round(a * RESOLUTION);
}

[numthreads(8, 8, 1)]
void Project(uint3 id : SV_DispatchThreadID)
{
    float d0;
    int2 v0 = project(id.xy / RESOLUTION, Input[id.xy].a, d0);
    
    int2 v1 = (v0 - (v0 % GROUP_SIZE)) / GROUP_SIZE;
    
    float d1 = Depth[v1];
    if (d1 != 0 && d0 >= d1)
    {
        return;
    }
    
    // store the transformed lookup
    Transformed[v1] = id.xy / RESOLUTION;
    Depth[v1] = d0;
}




#pragma kernel Interpolate

[numthreads(8, 8, 1)]
void Interpolate(uint3 id : SV_DispatchThreadID)
{
    int2 tc = id.xy;
    float2 dc = Transformed[tc];
    if (any(dc))
    {
        return;
    }
    
    // loop in spiral to search neighbors
    int x, y, dx, dy;
    x = y = dx = 0;
    dy = -1;
    int tmp;
    for (int i = 0; i < SEARCH_RADIUS; i++)
    {
        tc = (id.xy + int2(x, y)) % (RESOLUTION / GROUP_SIZE);
        dc = Transformed[tc];
        if (any(dc))
        {
            break;
        }
        
        if ((x == y) || ((x < 0) && (x == -y)) || ((x > 0) && (x == 1 - y)))
        {
            tmp = dx;
            dx = -dy;
            dy = tmp;
        }
        x += dx;
        y += dy;
    }
    
    if (!any(dc))
    {
        return;
    }
    
    Transformed[id.xy] = dc;
}


#pragma kernel Reproject

float2 InterpolateCoords(float2 uv, float2 vbl, float2 vbr, float2 vtl, float2 vtr)
{
    float wbl = (1 - uv.x) * (1 - uv.y);
    float wbr = uv.x * (1 - uv.y);
    float wtl = (1 - uv.x) * uv.y;
    float wtr = uv.x * uv.y;
    
    return vtl * wtl + vtr * wtr + vbl * wbl + vbr * wbr;
}


[numthreads(8, 8, 1)]
void Reproject(uint3 id : SV_DispatchThreadID)
{
    int2 bl = floor(id.xy / GROUP_SIZE);
    int2 br = bl + int2(1, 0);
    int2 tl = bl + int2(0, 1);
    int2 tr = bl + int2(1, 1);
    
    float2 vbl = Transformed[bl];
    float2 vbr = Transformed[br];
    float2 vtl = Transformed[tl];
    float2 vtr = Transformed[tr];
    
    // normalized local coords
    uint2 off = uint2(1, 0);
    float2 nc = id.xy / GROUP_SIZE - bl;
    float2 nl = (id.xy + off) / GROUP_SIZE - bl;
    float2 nr = (id.xy - off) / GROUP_SIZE - bl;
    float2 nt = (id.xy + off.yx) / GROUP_SIZE - bl;
    float2 nb = (id.xy - off.yx) / GROUP_SIZE - bl;
    
    float2 ic = InterpolateCoords(nc, vbl, vbr, vtl, vtr);
    float2 il = InterpolateCoords(nl, vbl, vbr, vtl, vtr);
    float2 ir = InterpolateCoords(nr, vbl, vbr, vtl, vtr);
    float2 it = InterpolateCoords(nt, vbl, vbr, vtl, vtr);
    float2 ib = InterpolateCoords(nb, vbl, vbr, vtl, vtr);
    
    float dc = Input.SampleLevel(sampler_linear_repeat, ic, 0).a;
    float dl = Input.SampleLevel(sampler_linear_repeat, il, 0).a;
    float dr = Input.SampleLevel(sampler_linear_repeat, ir, 0).a;
    float dt = Input.SampleLevel(sampler_linear_repeat, it, 0).a;
    float db = Input.SampleLevel(sampler_linear_repeat, ib, 0).a;
    
    float d0;
    int2 rc = project(ic, dc, d0);
    
    // float4 col = Input[ic * RESOLUTION];
    
    // RasterizeRightTriangle(rc, rl, rt, col);
    // RasterizeRightTriangle(rc, rt, rr, col);
    // RasterizeRightTriangle(rc, rr, rb, col);
    // RasterizeRightTriangle(rc, rb, rt, col);
    
    
    /*
    float d1 = DepthResult[rp];
    if (d1 != 0 && d0 >= d1)
    {
        return;
    }
    */
    // Result[rp] = ic.xyxy;
    // InvTransformed[rp] = ic * RESOLUTION;
    InvTransformed[id.xy] = float4(ic * RESOLUTION, rc);
    DepthReprojected[id.xy] = d0;
    // DepthResult[rp] = d0;
}


#pragma kernel Reinterpolate


#if WIREFRAME
// Based on: https://jstutorial.medium.com/how-to-code-your-first-algorithm-rdaw-a-line-ca121f9a1395
void DrawLine(int2 p0, int2 p1)
{
    float4 col = float4(1, 1, 1, 1);

    // Iterators, counters required by algorithm
    int x, y, dx, dy, dx1, dy1, px, py, xe, ye, i;

    // Calculate line deltas
    dx = p1.x - p0.x;
    dy = p1.y - p0.y;

    // Create a positive copy of deltas (makes iterating easier)
    dx1 = abs(dx);
    dy1 = abs(dy);

    // Calculate error intervals for both axis
    px = 2 * dy1 - dx1;
    py = 2 * dx1 - dy1;

    // The line is X-axis dominant
    if (dy1 <= dx1)
    {
        // Line is rdawn left to right
        if (dx >= 0)
        {
            x = p0.x; y = p0.y; xe = p1.x;
        }
        else
        {
            // Line is rdawn right to left (swap ends)
            x = p1.x; y = p1.y; xe = p0.x;
        }

        // Result[uint2(x, y)] = col; // Draw first pixel

        // Rasterize the line
        for (int i = 0; x < xe; i++) {
            x = x + 1;

            // Deal with octants...
            if (px < 0)
            {
                px = px + 2 * dy1;
            }
            else
            {
                if ((dx < 0 && dy < 0) || (dx > 0 && dy > 0))
                {
                    y = y + 1;
                }
                else
                {
                    y = y - 1;
                }

                px = px + 2 * (dy1 - dx1);
            }

            // Draw pixel from line span at
            // currently rasterized position
            Result[uint2(x, y)] = col;
        }
    }
    else
    {
        // The line is Y-axis dominant
        // Line is rdawn bottom to top
        if (dy >= 0)
        {
            x = p0.x; y = p0.y; ye = p1.y;
        }
        else
        {
            // Line is rdawn top to bottom
            x = p1.x; y = p1.y; ye = p0.y;
        }

        // Result[uint2(x, y)] = col; // Draw first pixel
        
        // Prevent unrolling of loop
        if (y == ye)
            return;
        
        // Rasterize the line
        for (int i = 0; y < ye; i++)
        {
            y = y + 1;

            // Deal with octants...
            if (py <= 0)
            {
                py = py + 2 * dx1;
            }
            else
            {
                if ((dx < 0 && dy < 0) || (dx > 0 && dy > 0))
                {
                    x = x + 1;
                }
                else
                {
                    x = x - 1;
                }

                py = py + 2 * (dx1 - dy1);
            }

            // Draw pixel from line span at
            // currently rasterized position
            Result[uint2(x, y)] = col;
        }
    }
}
#endif

struct ProjectedPoint
{
    // projected coordinates
    int2 pc;
    
    // corresponding original coordinates
    int2 oc;
    
    // projected dpeth value (non-normalized)
    float d;
};

struct Triangle
{
    // vertex points ascending by height
    ProjectedPoint v0, v1, v2;
};

float3 InterpolateTriangle(int x, int y, int2 v0, int2 v1, int2 v2)
{
    float dv = (v1.y - v2.y) * (v0.x - v2.x) + (v2.x - v1.x) * (v0.y - v2.y);
    float w0 = ((v1.y - v2.y) * (x - v2.x) + (v2.x - v1.x) * (y - v2.y)) / dv;
    float w1 = ((v2.y - v0.y) * (x - v2.x) + (v0.x - v2.x) * (y - v2.y)) / dv;
    float w2 = 1 - w0 - w1;

    return float3(w0, w1, w2);
}

void DrawRow(int x0, int y0, int x1, Triangle tri)
{
    int sx, ex;

    if (x0 < x1)
    {
        sx = x0;
        ex = x1;
    }
    else
    {
        sx = x1;
        ex = x0;
    }
    
    if (ex - sx <= 0)
        return;

    for (int i = sx; i <= ex; i++)
    {
        float3 w = InterpolateTriangle(i, y0, tri.v0.pc, tri.v1.pc, tri.v2.pc);
        int2 pc = tri.v0.oc * w.x + tri.v1.oc * w.y + tri.v2.oc * w.z;
        float2 uv = pc / float2(RESOLUTION);
        float d = tri.v0.d * w.x + tri.v1.d * w.y + tri.v2.d * w.z;
        uint2 tc = uint2(i, y0);
        float og = DepthResult[tc];
        
        if (d < og || og == 0)
        {
            DepthResult[tc] = d;
            Result[tc] = Input[pc];
        }
    }
}

// Based on: http://www.sunshine2k.de/coding/java/TriangleRasterization/TriangleRasterization.html
void FillTopFlatTriangle(Triangle tri)
{
    if (tri.v0.pc.y >= tri.v1.pc.y)
        return;

    float invslope1 = (tri.v1.pc.x - tri.v0.pc.x) / (float) (tri.v1.pc.y - tri.v0.pc.y);
    float invslope2 = (tri.v2.pc.x - tri.v0.pc.x) / (float) (tri.v2.pc.y - tri.v0.pc.y);

    float curx1 = tri.v0.pc.x;
    float curx2 = tri.v0.pc.x;

    for (int scanlineY = tri.v0.pc.y; scanlineY <= tri.v1.pc.y; scanlineY++)
    {
        DrawRow(curx1, scanlineY, curx2, tri);

        curx1 += invslope1;
        curx2 += invslope2;
    }
}

// See comment above
void FillBottomFlatTriangle(Triangle tri)
{
    if (tri.v0.pc.y <= tri.v1.pc.y)
        return;

    float invslope1 = (tri.v0.pc.x - tri.v1.pc.x) / (float) (tri.v0.pc.y - tri.v1.pc.y);
    float invslope2 = (tri.v0.pc.x - tri.v2.pc.x) / (float) (tri.v0.pc.y - tri.v2.pc.y);

    float curx1 = tri.v0.pc.x;
    float curx2 = tri.v0.pc.x;

    for (int scanlineY = tri.v0.pc.y; scanlineY > tri.v1.pc.y; scanlineY--)
    {
        DrawRow(curx1, scanlineY, curx2, tri);

        curx1 -= invslope1;
        curx2 -= invslope2;
    }
}

void FillTriangle(Triangle tri)
{
    // create a 4th vertex
    ProjectedPoint v3;
    v3.pc = int2(tri.v0.pc.x + ((float) (tri.v1.pc.y - tri.v0.pc.y) / (float) (tri.v2.pc.y - tri.v0.pc.y)) * (tri.v2.pc.x - tri.v0.pc.x), tri.v1.pc.y);
    float l0 = length(tri.v0.pc - v3.pc);
    float l2 = length(tri.v2.pc - v3.pc);
    float w0 = l0 / (l0 + l2);
    float w2 = 1 - w0;
    v3.oc = tri.v0.oc * w0 + tri.v2.oc * w2;
    v3.d = tri.v0.d * w0 + tri.v2.d * w2;
    
    // split the triangle in 2
    Triangle top, btm;
    top.v0 = tri.v0;
    btm.v0 = tri.v2;
    top.v1 = btm.v1 = tri.v1;
    top.v2 = btm.v2 = v3;
    
    FillTopFlatTriangle(tri);
    FillBottomFlatTriangle(tri);

#if WIREFRAME
    if (v0.y != v1.y || v0.y != v2.y)
    {
        DrawLine(v0, v1);
        DrawLine(v0, v2);
        DrawLine(v1, v2);
        DrawLine(v1, v3);
    }
#endif
}

// only sort a quad's extremes (highest and lowest)
void SortQuadExtremesVertically(inout ProjectedPoint points[4])
{
    int y0 = points[0].pc.y;
    int y1 = points[1].pc.y;
    int y2 = points[2].pc.y;
    int y3 = points[3].pc.y;
    
    // Find the highest and lowest y components
    int highestY = max(max(y0, y1), max(y2, y3));
    int lowestY = min(min(y0, y1), min(y2, y3));
    
    // Find the lowest vector
    ProjectedPoint lowest;
    if (y0 == lowestY)
    {
        lowest = points[0];
    }
    else if (y1 == lowestY)
    {
        lowest = points[1];
    }
    else if (y2 == lowestY)
    {
        lowest = points[2];
    }
    else
    {
        lowest = points[3];
    }
    
    // Find the highest vector
    ProjectedPoint highest;
    if (y0 == highestY)
    {
        highest = points[0];
    }
    else if (y1 == highestY)
    {
        highest = points[1];
    }
    else if (y2 == highestY)
    {
        highest = points[2];
    }
    else
    {
        highest = points[3];
    }

    // Find the first middle vector
    ProjectedPoint middle1;
    if (y0 != highest.pc.y && y0 != lowest.pc.y)
    {
        middle1 = points[0];
    }
    else if (y1 != highest.pc.y && y1 != lowest.pc.y)
    {
        middle1 = points[1];
    }
    else if (y2 != highest.pc.y && y2 != lowest.pc.y)
    {
        middle1 = points[2];
    }
    else
    {
        middle1 = points[3];
    }

    // Find the second middle vector
    ProjectedPoint middle2;
    if (y0 != highest.pc.y && y0 != lowest.pc.y && y0 != middle1.pc.y)
    {
        middle2 = points[0];
    }
    else if (y1 != highest.pc.y && y1 != lowest.pc.y && y1 != middle1.pc.y)
    {
        middle2 = points[1];
    }
    else if (y2 != highest.pc.y && y2 != lowest.pc.y && y2 != middle1.pc.y)
    {
        middle2 = points[2];
    }
    else
    {
        middle2 = points[3];
    }

    // Assign the sorted vectors back to the input array
    points[0] = lowest;
    points[1] = highest;
    points[2] = middle1;
    points[3] = middle2;
}

[numthreads(8, 8, 1)]
void Reinterpolate(uint3 id : SV_DispatchThreadID)
{
    uint2 off = uint2(1, 0);
    float4 rc = InvTransformed[id.xy];
    float4 rl = InvTransformed[id.xy + off];
    float4 rt = InvTransformed[id.xy + off.yx];
    float4 rlt = InvTransformed[id.xy + off.xx];
    
    float dc = DepthReprojected[id.xy];
    float dl = DepthReprojected[id.xy + off];
    float dt = DepthReprojected[id.xy + off.yx];
    float dlt = DepthReprojected[id.xy + off.xx];
    
    // skip too large triangles
    if (length(rc - rl) + length(rl - rt) + length(rt - rlt) + length(rlt - rc) > 100)
    {
        return;
    }
    
    ProjectedPoint v0, v1, v2, v3;
    ProjectedPoint neighbors[4];
    
    // temporary assignment
    neighbors[0].oc = rc.xy;
    neighbors[0].pc = rc.zw;
    neighbors[0].d = dc;
    
    neighbors[1].oc = rl.xy;
    neighbors[1].pc = rl.zw;
    neighbors[1].d = dl;
    
    neighbors[2].oc = rt.xy;
    neighbors[2].pc = rt.zw;
    neighbors[2].d = dt;
    
    neighbors[3].oc = rlt.xy;
    neighbors[3].pc = rlt.zw;
    neighbors[3].d = dlt;
    
    SortQuadExtremesVertically(neighbors);
    
    Triangle t0, t1;
    t0.v0 = t1.v0 = neighbors[0];
    t0.v1 = neighbors[1];
    t1.v1 = neighbors[2];
    t0.v2 = t1.v2 = neighbors[3];
    
    FillTriangle(t0);
    FillTriangle(t1);
        
    // RasterizeRightTriangle(rc, rl, rt, float4(id.xy / RESOLUTION, 0, 1));
    // FillTriangle(rc.zw, rl.zw, rt.zw, rc.xy, rl.xy, rt.xy, dc, dl, dt);
    // FillTriangle(rlt.zw, rl.zw, rt.zw, rlt.xy, rl.xy, rt.xy, dlt, dl, dt);
    // Result[id.xy] = float4(rc / RESOLUTION, 0, 1);
    // Result[id.xy] = float4((length(rc - rt) / 10).xxx, 1);
    
    // Result[id.xy] = float4(tc / RESOLUTION, 0, 1);
    // Result[id.xy] = Input[InvTransformed[id.xy].xy];
    
    /*
    int2 tc = id.xy;
    float4 dc = Result[tc];
    if (any(dc))
    {
        return;
    }
    
    // loop in spiral to search neighbors
    int x, y, dx, dy;
    x = y = dx = 0;
    dy = -1;
    int tmp;
    for (int i = 0; i < SEARCH_RADIUS; i++)
    {
        tc = (id.xy + int2(x, y)) % RESOLUTION;
        dc = Result[tc];
        if (any(dc))
        {
            break;
        }
        
        if ((x == y) || ((x < 0) && (x == -y)) || ((x > 0) && (x == 1 - y)))
        {
            tmp = dx;
            dx = -dy;
            dy = tmp;
        }
        x += dx;
        y += dy;
    }
    
    if (!any(dc))
    {
        return;
    }
    */
    // Result[id.xy] = dc;
}
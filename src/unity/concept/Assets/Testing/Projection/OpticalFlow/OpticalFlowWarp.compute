#pragma kernel Project
#pragma kernel Interpolate
#define PI 3.141592653589793238462
#define PI2 6.283185307179586476924

float2 UV;
float2 RESOLUTION;
float3 POSITION;

Texture2D<float4> Input, ProjectedInput;
RWTexture2D<float4> Projected, Result;


float2 uv2ll(float2 uv)
{
    return float2(
        uv.y * PI,
        uv.x * PI2 + PI
    );
}

float2 ll2uv(float2 ll)
{
    return float2(
        ll.y / PI2 + 0.5,
        ll.x / PI
    );
}

float3 ll2vec(float2 ll, float dist = 1)
{
    return float3(
        dist * sin(ll.y) * sin(ll.x),
        dist * cos(ll.x),
        dist * cos(ll.y) * sin(ll.x)
    );
}
            
float2 vec2ll(float3 vec, float dist = 1)
{
    return float2(
        acos(vec.y / dist),
        atan2(vec.x, vec.z)
    );
}

float2 translateLatLon(float2 ll, float3 vec, float dist = 1)
{
    float3 P = ll2vec(ll, dist);
    P += vec;

    float d = length(P);
    return vec2ll(P, d);
}

uint2 wrap(uint2 tc, uint x, uint y)
{
    return (tc + uint2(x, y)) % uint2(RESOLUTION);
}


[numthreads(8,8,1)]
void Project(uint3 id : SV_DispatchThreadID)
{
    float2 uv0 = id.xy / RESOLUTION;
    float2 ll0 = uv2ll(uv0);
    float d = Input[id.xy].a;
    float2 ll1 = translateLatLon(ll0, POSITION, d);
    float2 uv1 = ll2uv(ll1);
    uint2 tc1 = uv1 * RESOLUTION;

    Projected[tc1] = float4(uv0, 0, 1);
}

[numthreads(8, 8, 1)]
void Interpolate(uint3 id : SV_DispatchThreadID)
{
    uint2 fac = uint2(2, 1);

    float2 uv = ProjectedInput[id.xy].xy;

    if (any(uv))
    {
        Result[id.xy] = float4(uv, 0, 1);
        return;
    }

    uv = float2(0.5, 1);
    float d00, d10, d01, d11;
    float2 uv00, uv10, uv01, uv11;

    for (uint i = 1; i < 2000; i++)
    {
        // bottom left pixel
        if (d00 == 0)
        {
            uv00 = ProjectedInput[wrap(id.xy, -i, -i)].xy;

            if (any(uv00))
                d00 = i;
        }

        // bottom right pixel
        if (d10 == 0)
        {
            uv10 = ProjectedInput[wrap(id.xy, i, -i)].xy;

            if (any(uv10))
                d10 = i;
        }

        // top left pixel
        if (d01 == 0)
        {
            uv01 = ProjectedInput[wrap(id.xy, -i, i)].xy;

            if (any(uv01))
                d01 = i;
        }

        // top right pixel
        if (d11 == 0)
        {
            uv11 = ProjectedInput[wrap(id.xy, i, i)].xy;

            if (any(uv11))
                d11 = i;
        }

        if (all(float4(d00, d10, d01, d11)))
            break;
    }

    // just an estimation, not exact uv values
    float u = d00 / (d00 + d10);

    // lerp
    float2 uvh = lerp(uv00, uv10, u);
    float2 uvv = lerp(uv10, uv11, u);
    uv = lerp(uvh, uvv, u);

    Result[id.xy] = float4(uv, 0, 1);
}

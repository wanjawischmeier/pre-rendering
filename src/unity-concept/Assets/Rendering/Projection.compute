float PI, PI2, FOV, FCLIP;
float2 Rotation;
float3 Position;
float Off;
bool Debug;

#pragma kernel Projection;
#pragma kernel Gnomonic;

StructuredBuffer<float3> OffsetBuffer;
StructuredBuffer<float3> DebugOffsetBuffer;
Texture2DArray<float4> InputArray;
RWTexture2D<float4> Projected;
Texture2D<float4> ProjectedIn;
RWTexture2D<float4> Result;
SamplerState sampler_trilinear_repeat;

[numthreads(8, 8, 1)]
void Projection(uint3 id : SV_DispatchThreadID)
{
    uint InputWidth, InputHeight, InputDepth, TransWidth, TransHeight;
    InputArray.GetDimensions(InputWidth, InputHeight, InputDepth);
    Projected.GetDimensions(TransWidth, TransHeight);
    float2 InputRes = float2(InputWidth, InputHeight);
    float2 TransRes = float2(TransWidth, TransHeight);
    
    float3 nrmIdx = float3(id.xy / TransRes, id.z / (float) InputDepth);
    float3 inpIdx = float3(id.xy / TransRes * InputRes, id.z);
    
    float2 ll1 = id.yx / TransRes.yx;
    ll1.x *= PI;
    ll1.y *= PI2;
    ll1.y += PI;
    
    float CP = InputArray[inpIdx].a * FCLIP;
    
    float3 P = float3(
        CP * sin(ll1.y) * sin(ll1.x),
        CP * cos(ll1.x),
        CP * cos(ll1.y) * sin(ll1.x)
    );
    float3 PN = float3(
        FCLIP * sin(ll1.y) * sin(ll1.x),
        FCLIP * cos(ll1.x),
        FCLIP * cos(ll1.y) * sin(ll1.x)
    );
    
    P -= Position;
    PN -= Position;
    P += OffsetBuffer[id.z];
    P += DebugOffsetBuffer[id.z];
    
    float d = sqrt(P.x * P.x + P.y * P.y + P.z * P.z);
    float dN = sqrt(PN.x * PN.x + PN.y * PN.y + PN.z * PN.z);
    
    float2 ll2 = float2(
        acos(P.y / d),
        atan2(P.x, P.z)
    );
    float2 ll2N = float2(
        acos(PN.y / dN),
        atan2(PN.x, PN.z)
    );
    
    float2 a = float2(
        ll2.y / PI2,
        ll2.x / PI
    );
    a.x += 0.5;
    float2 aN = float2(
        ll2N.y / PI2,
        ll2N.x / PI
    );
    aN.x += 0.5;
    
    float2 idx = round(a * TransRes);
    float2 idxN = round(aN * TransRes);
    
    if (all(Projected[idx] == 0) || d < Projected[idx].a)
    {
        if (any(InputArray[inpIdx].xyz))
        {
            Projected[idx] = float4(inpIdx, d);
        }
    }
}

[numthreads(8, 8, 1)]
void Gnomonic(uint3 id : SV_DispatchThreadID)
{
    uint InputWidth, InputHeight, InputDepth, ProjectedW, ProjectedH, ResultW, ResultH;
    InputArray.GetDimensions(InputWidth, InputHeight, InputDepth);
    ProjectedIn.GetDimensions(ProjectedW, ProjectedH);
    Result.GetDimensions(ResultW, ResultH);
    float2 InputRes = float2(InputWidth, InputHeight);
    float2 ProjectedRes = float2(ProjectedW, ProjectedH);
    float2 ResultRes = float2(ResultW, ResultH);
    
    PI2 = PI * 2;

    float x = PI2 * (id.x / (float) ResultW - 0.5);
    float y = PI * (id.y / (float) ResultH - 0.5);

    float p = sqrt(x * x + y * y);
    float c = atan2(p, FOV);

    float sinC = sin(c);
    float cosC = cos(c);
    float sinPhi1 = sin(Rotation.x);
    float cosPhi1 = cos(Rotation.x);

    float phi = asin(cosC * sinPhi1 + y * sinC * cosPhi1 / p);
    float lambda = Rotation.y + atan2(x * sinC, (p * cosPhi1 * cosC - y * sinPhi1 * sinC));

    float2 tc = float2(lambda / (PI * 2.0) + 0.5, phi / PI + 0.5);
    /*
    float2 pIdx = tc * ProjectedRes;
    
    if (ProjectedIn[pIdx].a == 0)
    {
        // n = N + 1
        int n = 50;
        
        // Based on https://stackoverflow.com/a/398302/13215204
        
        int x, y, dx, dy, hW;
        x = dx = 1;
        y = dy = 0;
        hW = sqrt(n) / 2;
        
        for (int i = 0; i < n; i++)
        {
            float2 nIdx = pIdx + float2(x, y);
            
            tc = nIdx / ProjectedRes;
            if ((-hW < x <= hW) && (-hW < y <= hW))
            {
                // (ProjectedIn[nIdx].a != 0)
                // break;
            }
            if (x == y || (x < 0 && x == -y) || (x > 0 && x == 1 - y)) dx, dy = -dy, dx;
            x, y = x + dx, y + dy;
        }

    }
    */
    float3 idx = ProjectedIn.SampleLevel(sampler_trilinear_repeat, tc, 0).xyz;
    
    if (Debug)
        Result[id.xy] = float4(idx.xy / ResultRes, 0, 1);
        // Result[id.xy] = (ProjectedIn[tc * ProjectedRes].xy / ProjectedRes).xyxy;
        // Result[id.xy] = ProjectedIn[pIdx].a == 0 ? float4(1, 0, 0, 1) : float4(0, 1, 0, 1);
    else Result[id.xy] = InputArray[idx];
}
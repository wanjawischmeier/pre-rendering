int IMG_IDX;
float PI, PI2, FCLIP;
float3 Position;

#pragma multi_compile PERCISION_LOW PERCISION_HIGH
#include "Assets/Tests.cs"
#if PERCISION_LOW
typedef half  num;
typedef half1 num1;
typedef half2 num2;
typedef half3 num3;
typedef half4 num4;
#elif PERCISION_HIGH
typedef float  num;
typedef float1 num1;
typedef float2 num2;
typedef float3 num3;
typedef float4 num4;
#endif

#pragma kernel Projection;
StructuredBuffer<num3> OffsetBuffer;
StructuredBuffer<num3> DebugOffsetBuffer;
Texture2DArray<num4> InputArray;
RWTexture2D<num4> Projected;

[numthreads(8, 8, 1)]
void Projection(uint3 id : SV_DispatchThreadID)
{
    uint InputWidth, InputHeight, InputDepth, ProjectedWidth, ProjectedHeight;
    InputArray.GetDimensions(InputWidth, InputHeight, InputDepth);
    Projected.GetDimensions(ProjectedWidth, ProjectedHeight);
    float2 InputRes = float2(InputWidth, InputHeight);
    float2 ProjectedRes = float2(ProjectedWidth, ProjectedHeight);
    
    float3 inpIdx = float3(id.xy / ProjectedRes * InputRes, IMG_IDX);
    
    float2 ll1 = id.yx / ProjectedRes.yx;
    ll1.x *= PI;
    ll1.y *= PI2;
    ll1.y += PI;
    
    float CP = InputArray[inpIdx].a * FCLIP;
    
    float3 P = float3(
        CP * sin(ll1.y) * sin(ll1.x),
        CP * cos(ll1.x),
        CP * cos(ll1.y) * sin(ll1.x)
    );
    
    P -= Position;
    P += OffsetBuffer[IMG_IDX];
    P += DebugOffsetBuffer[IMG_IDX];
    
    float d = sqrt(P.x * P.x + P.y * P.y + P.z * P.z);
    
    float2 ll2 = float2(
        acos(P.y / d),
        atan2(P.x, P.z)
    );
    
    float2 a = float2(
        ll2.y / PI2,
        ll2.x / PI
    );
    a.x += 0.5;
    
    float2 idx = round(a * ProjectedRes);
    
    Projected[idx] = num4(id.xy / ProjectedRes, IMG_IDX, d);
}

#pragma kernel Combine
Texture2D<num4> Input;
SamplerState sampler_Input;
RWTexture2D<num4> Result;

[numthreads(8, 8, 1)]
void Combine(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);
    float2 ResultRes = float2(width, height);
    
    num4 old = Result[id.xy];
    num4 col = Input.SampleLevel(sampler_Input, id.xy / ResultRes, 0);
    
    if (col.a != 0) // TODO: Depth sorting (d < Projected[idx].a)
        Result[id.xy] = col;
}